# ==== Приложение ====
APP_ENV=development
APP_SECRET=change-me-64-hex
# Публичный базовый URL (для ссылок /room/{id} в логах и письмах-заглушках)
PUBLIC_BASE_URL=http://localhost:8090
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==== PostgreSQL (ВНЕ docker compose) ====
# На egorserver PostgreSQL 16 слушает порт 15432; из контейнера ходим на docker0-адрес хоста.
# pg_hba требует hostssl -> ssl=require обязателен.
DATABASE_URL=postgresql+asyncpg://dubbing:CHANGE_ME@172.17.0.1:15432/dubbing?ssl=require
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_ECHO=false

# ==== Redis (в compose) ====
REDIS_URL=redis://redis:6379/0

# ==== Хранилище ====
STORAGE_ROOT=/data
MAX_UPLOAD_MB=2048
MAX_VIDEO_MINUTES=10
MAX_ROOM_BYTES=6442450944
MIN_FREE_DISK_MB=2048
ROOM_TTL_DAYS=7
GLOBAL_MAX_ACTIVE_ROOMS=50

# Обслуживание очереди: этап, висящий дольше, помечается FAILED (воркер не отвечает)
JOB_STAGE_STALL_MINUTES=20
MAINTENANCE_INTERVAL_S=120

# ==== Комната/участник ====
ROOM_ID_BYTES=16
PARTICIPANT_TOKEN_BYTES=32
ASSIGNMENT_TTL_MINUTES=15
ASSIGNMENT_HEARTBEAT_GRACE_S=60

# ==== Запись ====
RECORD_TOLERANCE_MS=250
RECORD_LOUDNESS_TARGET=-16
RECORD_MAX_TAKE_MB=25

# ==== Диалог/нарезка ====
MERGE_GAP_MS=350
SENTENCE_GAP_MS=150
MIN_LINE_MS=600
MAX_LINE_MS=12000
SHORT_LINE_MS=400
SEGMENT_PAD_MS=80

# ==== ML ====
SEPARATION_MODEL=bandit_v2            # bandit_v2 | demucs
SEPARATION_MODE=subtract_and_duck     # subtract_and_duck | subtract_only | stems_sum
SEPARATION_CHUNK_S=25
SEPARATION_OVERLAP_S=1
DEFAULT_DUCKING_DB=-7
# Bandit: путь к чекпоинту (Zenodo record 12701995, checkpoint-multi.ckpt) и дуккинг.
# Дуккинг 0 — фон из стемов music+sfx не содержит речи, приглушать нечего.
BANDIT_WEIGHTS_PATH=/data/models/bandit/checkpoint-multi.ckpt
BANDIT_DUCKING_DB=0
STT_BACKEND=whisper                   # whisper | parakeet
STT_MODEL=large-v3                    # large-v3 | large-v3-turbo
STT_FALLBACK_MODEL=large-v3-turbo
STT_LANGUAGE=                          # пусто = автоопределение
ALIGNMENT_MODEL=WAV2VEC2_ASR_BASE_960H
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_FALLBACK_MODEL=nvidia/diar_streaming_sortformer_4spk-v2.1
MAX_SPEAKERS_DEFAULT=0                # 0 = автоопределение
MODEL_CACHE_DIR=/root/.cache/huggingface
HF_TOKEN=
HF_HOME=/root/.cache/huggingface

# ==== GPU ====
GPU_DEVICE=0
GPU_JOB_CONCURRENCY=1
# Порядок LD_LIBRARY_PATH для ML-воркера: сначала pip-библиотеки nvidia-* (см. Dockerfile.ml),
# затем системные из базового CUDA-образа. Иначе конфликт версий cuDNN.
ML_LD_LIBRARY_PATH=/opt/venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cublas/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cufft/lib:/opt/venv/lib/python3.12/site-packages/nvidia/curand/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cusolver/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cusparse/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cusparselt/lib:/opt/venv/lib/python3.12/site-packages/nvidia/nccl/lib:/opt/venv/lib/python3.12/site-packages/nvidia/nvjitlink/lib:/opt/venv/lib/python3.12/site-packages/nvidia/nvshmem/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cu13/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cuda_cupti/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:/opt/venv/lib/python3.12/site-packages/nvidia/nvtx/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64
FFMPEG_BIN=ffmpeg
FFMPEG_TIMEOUT_S=900

# ==== Рендер ====
RENDER_LOUDNESS_TARGET=-16
UNRECORDED_POLICY=silent              # silent | original

# ==== Прочее ====
ENABLE_PROMETHEUS=false
SENTRY_DSN=
API_PORT=8091
# Приложение открыто на сервере под префиксом /dub/ (порт 3001 занят другим проектом).
# Локально оставляйте /api и / — сборка для разработки не отличается от серверной.
# Токен админки (/dub/admin в интерфейсе, заголовок X-Admin-Token).
# Пусто — админка выключена. Сгенерировать: openssl rand -hex 24
ADMIN_TOKEN=
VITE_API_BASE=/dub/api
VITE_BASE_PATH=/dub/
FRONTEND_PORT=8090
FRONTEND_BIND=127.0.0.1
